#!/usr/bin/expect -f
set timeout 60
set password "d3anth0ms0n"
set host "melbourneguitarschool.com.au"
set user "grahf"

spawn ssh $user@$host
expect {
    "Are you sure you want to continue connecting" {
        send "yes\r"
        exp_continue
    }
    "password:" {
        send "$password\r"
    }
}
expect "$ "
send "export TERM=xterm\r"
expect "$ "
send "chmod +x ~/melbourne-guitar-school/deploy/maintenance-remote-test.sh\r"
expect "$ "
# Run with bash -u to catch unbound variables
send "bash -u ~/melbourne-guitar-school/deploy/maintenance-remote-test.sh --interactive --skip-pull\r"

send "chmod +x ~/melbourne-guitar-school/deploy/maintenance-remote-test.sh\r"
expect "$ "
# Run with bash -u to catch unbound variables
send "bash -u ~/melbourne-guitar-school/deploy/maintenance-remote-test.sh --interactive --skip-pull\r"
expect {
    "Select" {
        send "q\r"
    }
    "error" {
        # Catch errors
    }
    timeout {
        # Timeout
    }
}
expect "$ "
send "rm ~/melbourne-guitar-school/deploy/maintenance-remote-test.sh\r"
expect "$ "
send "exit\r"
expect eof
