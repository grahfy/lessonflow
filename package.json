{
  "name": "lessonflow",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "clean": "node -e \"const fs=require('node:fs');const paths=['.next'];for(const p of paths){if(fs.existsSync(p)){fs.rmSync(p,{recursive:true,force:true});}}for(const name of fs.readdirSync('.')){if(name.startsWith('.next_stale_')){fs.rmSync(name,{recursive:true,force:true});}}\"",
    "dev": "next dev",
    "dev:clean": "npm run clean && npm run dev",
    "local:full-site": "bash ./scripts/test-full-site-local.sh",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src/app src/components src/lib --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test:prepare": "node ./scripts/prepare-test-db.cjs",
    "test": "npm run test:prepare && node ./scripts/run-vitest-with-test-db.cjs run",
    "test:watch": "npm run test:prepare && node ./scripts/run-vitest-with-test-db.cjs",
    "test:e2e": "playwright test",
    "docs:screenshots:seed": "npx tsx ./scripts/seed-docs-screenshots.ts",
    "docs:screenshots": "playwright test tests/e2e/docs-screenshots.spec.ts",
    "docs:screenshots:sync": "node ./scripts/sync-manual-screenshots.cjs",
    "docs:screenshots:update": "npm run docs:screenshots && npm run docs:screenshots:sync",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@types/papaparse": "^5.5.2",
    "bcryptjs": "^3.0.2",
    "date-fns": "^4.1.0",
    "dotenv": "^17.3.1",
    "googleapis": "^171.4.0",
    "gsap": "^3.14.2",
    "lucide-react": "^0.575.0",
    "mariadb": "^3.5.1",
    "marked": "^17.0.3",
    "next": "^15.2.0",
    "nodemailer": "^7.0.5",
    "papaparse": "^5.5.3",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.34.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.13.10",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.22.0",
    "eslint-config-next": "^15.2.0",
    "prisma": "^7.5.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
