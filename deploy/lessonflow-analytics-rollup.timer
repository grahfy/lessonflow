# LessonFlow - Analytics Hourly Rollup Timer
# Install: sudo cp deploy/lessonflow-analytics-rollup.timer /etc/systemd/system/
# Enable:  sudo systemctl enable lessonflow-analytics-rollup.timer
# Status:  systemctl list-timers lessonflow-analytics-rollup.timer

[Unit]
Description=Run Analytics Rollup hourly
Documentation=https://gitlab.com/grahfmusic/lessonflow

[Timer]
# Run hourly to keep analytics aggregates refreshed without waiting for the
# next daily maintenance window.
OnCalendar=hourly
# If the timer was missed (e.g., server was down), run it when the system comes back up
Persistent=true
# Add a small random delay to avoid thundering herd
RandomizedDelaySec=60

[Install]
WantedBy=timers.target
