# LessonFlow - Admin Reports Weekly Timer
# Install: sudo cp deploy/lessonflow-admin-reports-weekly.timer /etc/systemd/system/
# Enable:  sudo systemctl enable lessonflow-admin-reports-weekly.timer
# Status:  systemctl list-timers lessonflow-admin-reports-weekly.timer

[Unit]
Description=Run Admin Reports Weekly on Monday at 8:00 AM
Documentation=https://github.com/your-org/lessonflow-website

[Timer]
# Run weekly on Monday at 8:00 AM
OnCalendar=Mon *-*-* 08:00:00
# If the timer was missed (e.g., server was down), run it when the system comes back up
Persistent=true
# Add a small random delay to avoid thundering herd
RandomizedDelaySec=60

[Install]
WantedBy=timers.target
