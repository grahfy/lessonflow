# Melbourne Guitar School - Systemd Service
# Install: sudo cp deploy/melbourne-guitar-school.service /etc/systemd/system/
# Enable:  sudo systemctl enable melbourne-guitar-school
# Start:   sudo systemctl start melbourne-guitar-school

[Unit]
Description=Melbourne Guitar School Next.js Application
Documentation=https://github.com/your-org/melbourne-guitar-school-website
After=network.target mysql.service
Wants=mysql.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=www-data
Group=www-data
# deploy.sh updates this symlink atomically to switch releases without editing
# the unit file on every deploy.
WorkingDirectory=/var/www/melbourne-guitar-school/current

# Environment
EnvironmentFile=/var/www/melbourne-guitar-school/shared/.env
Environment=NODE_ENV=production
Environment=PORT=3000

# Executable
# The standalone Next.js output embeds server code and reads static assets from
# the deployed release path prepared by deploy.sh.
ExecStart=/usr/bin/node /var/www/melbourne-guitar-school/current/.next/standalone/server.js

# Restart behavior
Restart=on-failure
RestartSec=10

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=melbourne-guitar-school

# Security hardening
# ReadWritePaths re-opens only the app deploy tree because ProtectSystem=strict
# would otherwise make the filesystem read-only for runtime uploads/log needs.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/melbourne-guitar-school
PrivateTmp=true

# Resource limits
LimitNOFILE=65535
MemoryMax=1G

[Install]
WantedBy=multi-user.target
