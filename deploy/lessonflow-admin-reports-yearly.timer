# LessonFlow - Admin Reports Yearly Timer
# Install: sudo cp deploy/lessonflow-admin-reports-yearly.timer /etc/systemd/system/
# Enable:  sudo systemctl enable lessonflow-admin-reports-yearly.timer
# Status:  systemctl list-timers lessonflow-admin-reports-yearly.timer

[Unit]
Description=Run Admin Reports Yearly on January 1st at 8:30 AM
Documentation=https://github.com/your-org/lessonflow-website

[Timer]
# Run yearly on January 1st at 8:30 AM
OnCalendar=*-01-01 08:30:00
# If the timer was missed (e.g., server was down), run it when the system comes back up
Persistent=true
# Add a small random delay to avoid thundering herd
RandomizedDelaySec=60

[Install]
WantedBy=timers.target
