# LessonFlow - Admin Reports Monthly Service
# Install: sudo cp deploy/lessonflow-admin-reports-monthly.service /etc/systemd/system/
# Enable:  sudo systemctl enable lessonflow-admin-reports-monthly
# Start:   sudo systemctl start lessonflow-admin-reports-monthly

[Unit]
Description=LessonFlow Admin Reports Monthly
Documentation=https://gitlab.com/grahfmusic/lessonflow
After=network.target lessonflow.service
Wants=lessonflow.service

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/var/www/lessonflow/current

# Load environment from shared .env
EnvironmentFile=/var/www/lessonflow/shared/.env

# Execute the cron runner script for admin-reports-monthly
ExecStart=/var/www/lessonflow/current/deploy/cron.sh admin-reports-monthly

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lessonflow-admin-reports-monthly

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/lessonflow /var/log/lessonflow
PrivateTmp=true

[Install]
WantedBy=multi-user.target
