# Melbourne Guitar School - Systemd Service
# Install: sudo cp deploy/lessonflow.service /etc/systemd/system/
# Enable:  sudo systemctl enable lessonflow
# Start:   sudo systemctl start lessonflow

[Unit]
Description=Melbourne Guitar School Next.js Application
Documentation=https://gitlab.com/grahfmusic/lessonflow
After=network.target mysql.service
Wants=mysql.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=www-data
Group=www-data
# deploy.sh updates this symlink atomically to switch releases without editing
# the unit file on every deploy.
WorkingDirectory=/var/www/lessonflow/current

# Environment
EnvironmentFile=/var/www/lessonflow/shared/.env
Environment=NODE_ENV=production
Environment=PORT=3000

# Executable
# The standalone Next.js output embeds server code and reads static assets from
# the deployed release path prepared by deploy.sh.
ExecStart=/usr/bin/node /var/www/lessonflow/current/.next/standalone/server.js

# Restart behavior
Restart=on-failure
RestartSec=10

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lessonflow

# Security hardening
# ReadWritePaths re-opens the app deploy tree and persistent git checkout used
# by update.sh when git maintenance is pinned to the deploy user.
NoNewPrivileges=false
ProtectSystem=full
ProtectHome=false
ReadWritePaths=/var/www/lessonflow /opt/melbourne-guitar-school
PrivateTmp=true

# Resource limits
LimitNOFILE=65535
MemoryMax=1G

[Install]
WantedBy=multi-user.target
