# LessonFlow - Analytics Data Purge Service
# Install: sudo cp deploy/lessonflow-analytics-purge.service /etc/systemd/system/
# Enable:  sudo systemctl enable lessonflow-analytics-purge
# Start:   sudo systemctl start lessonflow-analytics-purge

[Unit]
Description=LessonFlow Analytics Data Purge
Documentation=https://gitlab.com/grahfmusic/lessonflow
After=network.target lessonflow.service
Wants=lessonflow.service

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/var/www/lessonflow/current

# Load environment from shared .env
EnvironmentFile=/var/www/lessonflow/shared/.env

# Execute the cron runner script for analytics-purge
ExecStart=/var/www/lessonflow/current/deploy/cron.sh analytics-purge

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lessonflow-analytics-purge

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/lessonflow /var/log/lessonflow
PrivateTmp=true

[Install]
WantedBy=multi-user.target
