# LessonFlow - Web Update Runner
# Install/update: copied automatically by deploy.sh when UPDATES_DEPLOY_USER is set.

[Unit]
Description={{APP_NAME}} Web Update Runner
After=network.target
ConditionPathExists=/var/www/{{APP_NAME}}/current/scripts/start-web-update-service.sh

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/var/www/{{APP_NAME}}/current
EnvironmentFile=-/var/www/{{APP_NAME}}/shared/.env
Environment=MGS_SOURCE_GIT_USER={{DEPLOY_USER}}
Environment=MGS_SUDO_USER={{DEPLOY_USER}}
ExecStart=/usr/bin/env bash /var/www/{{APP_NAME}}/current/scripts/start-web-update-service.sh
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
