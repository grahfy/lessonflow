# Local development / production database (Prisma provider is mysql).
# Example local Docker MySQL: mysql://root:root@127.0.0.1:3306/mgs_dev
# Local test runs derive TEST_DATABASE_URL from this value when `.env.test.local`
# is missing by switching `mgs_dev` -> `mgs_test` and `3306` -> `3307`.
# Expected paired local test DB: mysql://root:root@127.0.0.1:3307/mgs_test
DATABASE_URL="mysql://root:root@127.0.0.1:3306/mgs_dev"
NEXT_PUBLIC_SITE_URL="https://melbourneguitarschool.com.au"
ADMIN_EMAIL="owner@example.com"
# Optional explicit contact for Let's Encrypt/certbot. When unset, deploy
# scripts fall back to ADMIN_EMAIL for first-time SSL setup.
SSL_EMAIL=""
ADMIN_PASSWORD="change-me"
ADMIN_SESSION_SECRET="change-me-session"
STUDENT_SESSION_SECRET="change-me-student-session"
STUDENT_SESSION_MAX_AGE_SECONDS="2592000"
STUDENT_PORTAL_PASSWORD_ENCRYPTION_KEY="change-me-student-portal-encryption-key"
STUDENT_PORTAL_PASSWORD_LENGTH="14"
CRON_SECRET="change-me-too"
# Production-only bootstrap secret for the first-run setup wizard.
# Open /setup?setupToken=<value> and the browser will forward it to the setup APIs.
SETUP_ACCESS_TOKEN=""
LEARNING_MATERIALS_STORAGE_DRIVER="local"
# For droplet production with local storage, use a persistent absolute path (e.g. /srv/mgs-data/learning-materials).
# Relative paths are for local development only and should not be used in standalone production deployments.
LEARNING_MATERIALS_LOCAL_ROOT=".data/learning-materials"
ADMIN_STAFF_PHOTOS_LOCAL_ROOT=".data/admin-staff-photos"
EMAIL_SIGNATURE_LOGO_LOCAL_ROOT=".data/email-signature-logo"

# Path to the persistent git repository for system updates (production only).
# In development, it defaults to the current directory.
UPDATES_GIT_REPO_PATH="/home/grahf/lessonflow"
# OS user that should run browser-triggered updates via the host-side systemd runner.
UPDATES_DEPLOY_USER="deploy"
LEARNING_MATERIALS_S3_BUCKET=""
LEARNING_MATERIALS_S3_REGION=""
LEARNING_MATERIALS_S3_ACCESS_KEY_ID=""
LEARNING_MATERIALS_S3_SECRET_ACCESS_KEY=""
LEARNING_MATERIALS_S3_PUBLIC_BASE_URL=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Melbourne Guitar School <no-reply@melbourneguitarschool.com.au>"

# Email Provider: smtp or gmail
EMAIL_PROVIDER="smtp"

# Gmail API OAuth requirements:
# - Generate GMAIL_REFRESH_TOKEN with both gmail.send and gmail.readonly scopes.
# - gmail.metadata alone is not enough for sent-message body sync or Gmail q filters.
# - If scopes change later, regenerate GMAIL_REFRESH_TOKEN and refresh email history.
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REFRESH_TOKEN=""
GMAIL_USER_EMAIL="your-email@gmail.com"
ADMIN_CUSTOMER_EMAIL_ALERTS_PROVIDER="gmail"
ADMIN_CUSTOMER_EMAIL_ALERTS_ENABLED="true"
IMAP_HOST=""
IMAP_PORT="993"
IMAP_USER=""
IMAP_PASS=""
IMAP_TLS="true"
IMAP_MAILBOX="INBOX"

# Admin report email detail row limits (used in manual/scheduled operations reports)
ADMIN_REPORT_EMAIL_APPOINTMENT_ROWS="10"
ADMIN_REPORT_EMAIL_OUTSTANDING_INVOICE_ROWS="12"

# Whitelabel Configuration
NEXT_PUBLIC_BRAND_NAME="Melbourne Guitar School"
NEXT_PUBLIC_PRIMARY_SUBJECT="Guitar"
NEXT_PUBLIC_PRIMARY_LOCATION="Northcote"
NEXT_PUBLIC_CONTACT_PHONE="0401 489 437"
NEXT_PUBLIC_CONTACT_ADDRESS="Rear 66/68 High St, Northcote VIC 3070"
NEXT_PUBLIC_LOGO_URL="/images/mgs-logo.webp"
NEXT_PUBLIC_INVOICE_LOGO_URL="/images/company-logo-invoice.png"
NEXT_PUBLIC_FAVICON_URL="/icon.png"
NEXT_PUBLIC_DEFAULT_CURRENCY="AUD"
# Explicit business timezone used for parsing and rendering lesson times.
# Keep this aligned with your operating timezone if you want system and app
# clocks to match, but the application does not rely on Linux localtime.
NEXT_PUBLIC_TIMEZONE="Australia/Melbourne"

# Invoice Configuration
INVOICE_BUSINESS_NAME="Melbourne Guitar School"
INVOICE_BUSINESS_ABN=""
INVOICE_BANK_NAME=""
INVOICE_BANK_BSB=""
INVOICE_BANK_ACCOUNT_NAME=""
INVOICE_BANK_ACCOUNT_NUMBER=""
INVOICE_PAYMENT_TERMS_DAYS="14"
INVOICE_GST_REGISTERED="false"
INVOICE_DEFAULT_TAX_MODE="gst_free"
# Optional JSON map for non-AUD invoice tax behavior.
# Example:
# INVOICE_TAX_PROFILES='{"USD":{"locale":"en-US","taxLabel":"Sales Tax","taxRateBasisPoints":825,"registered":true,"defaultTaxMode":"taxable"}}'
INVOICE_TAX_PROFILES=""
INVOICE_CREDIT_NOTE_PREFIX="MGSCN"

# =============================================================================
# Backup Configuration (for maintenance.sh and automatic backups)
# =============================================================================
# Backup frequency: hourly, daily, weekly, custom
BACKUP_FREQUENCY="daily"
# Cloud provider for backup upload: none, google-drive, koofr
BACKUP_CLOUD_PROVIDER="none"
# Cloud folder name for backups
BACKUP_CLOUD_FOLDER="lessonflow-backups"
# Number of days to retain backups (older backups are auto-deleted)
BACKUP_RETENTION_DAYS="30"

# Google Drive OAuth2 credentials (for cloud backup upload)
# Get these from https://console.cloud.google.com/apis/credentials
GDRIVE_CLIENT_ID=""
GDRIVE_CLIENT_SECRET=""
GDRIVE_REFRESH_TOKEN=""

# Koofr WebDAV credentials (alternative cloud backup via WebDAV)
# Get WebDAV password from https://app.koofr.net/preferences/password
KOOFR_WEBDAV_URL="https://app.koofr.net/dav/Koofr"
KOOFR_USERNAME=""
KOOFR_PASSWORD=""

# Observability
# Set to "1" to suppress console logging AND SystemLog DB writes. Leave UNSET in
# production: the vitest suite silences itself via VITEST, so NODE_ENV no longer
# gates suppression and a misconfigured prod runner keeps emitting real logs.
OBSERVABILITY_SILENT=""

# Trust boundary / proxy (rate-limiting and geo resolution)
# Deployment runs behind a single Nginx hop that sets X-Real-IP to the real
# client. Leave TRUST_PROXY unset/true so the app reads X-Real-IP (and parses
# X-Forwarded-For from the trusted-proxy side). Set TRUST_PROXY="false" only if
# the app is exposed with no trusted proxy in front (forces a single shared
# rate-limit bucket). TRUSTED_PROXY_HOPS is how many proxy hops append to XFF.
TRUST_PROXY="true"
TRUSTED_PROXY_HOPS="1"
# Only trust edge geo headers (x-vercel-ip-country / cf-ipcountry) when actually
# fronted by that platform. Leave UNSET on a single droplet so spoofable client
# geo headers are ignored. Valid values: "vercel" or "cloudflare".
TRUST_EDGE_GEO=""

# Cookies / abuse-protection bypasses
# Session cookies are marked Secure automatically when NODE_ENV=production. Set
# COOKIE_SECURE="1" to force Secure in other TLS-fronted environments.
COOKIE_SECURE=""
# DEV/TEST ONLY — never set these in production. They disable abuse protection.
# The vitest suite auto-detects itself via VITEST, so these are only needed for
# manual non-prod testing. CAPTCHA_TEST_BYPASS="1" skips captcha verification;
# RATE_LIMIT_DISABLED="1" disables rate limiting.
CAPTCHA_TEST_BYPASS=""
RATE_LIMIT_DISABLED=""
