/**
 * LessonFlow Database Schema
 * Powered by Prisma with a MySQL/MariaDB provider.
 * ARCHITECTURAL PRINCIPLES:
 * 1. Request/Booking Separation: Incoming leads (Requests) are kept distinct
 * from confirmed schedule slots (Bookings) to maintain a clean calendar.
 * 2. Financial Immutability: Invoices denormalize customer data (name, email,
 * ABN) at the time of creation so historical documents remain legally
 * accurate even if a student's profile is updated later.
 * 3. Audit Trails: All critical entities (Bookings, Invoices, Credentials)
 * feature append-only audit log tables for accountability.
 * 4. Soft Deletion: Financial records use `isDeleted` or `isArchived` flags
 * rather than hard deletes to preserve reporting integrity.
 */

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum LessonMode {
  in_person
  video
}

enum SkillLevel {
  beginner
  intermediate
  advanced
}

enum LessonDuration {
  min30
  min60
}

enum BookingRequestStatus {
  pending
  approved
  rejected
  cancelled
  waitlisted
}

enum BookingStatus {
  approved
  cancelled
}

enum AuditAction {
  created
  approved
  rejected
  moved
  cancelled
  edited
  reminder_sent
  custom_email_sent
  series_removed
  attendance_marked
  reschedule_requested
  reschedule_approved
  reschedule_declined
  waitlisted
  waitlist_promoted
}

enum AttendanceStatus {
  attended
  no_show
}

enum RescheduleRequestStatus {
  pending
  approved
  declined
}

enum InvoiceStatus {
  draft
  sent
  paid
  void
}

enum InvoiceDocumentType {
  invoice
  credit_note
}

enum InvoiceTaxMode {
  taxable
  gst_free
}

enum InvoiceDiscountKind {
  amount
  percent
}

enum InvoicePaymentDetailsSource {
  system
  custom
}

enum InvoiceAuditAction {
  created
  edited
  sent
  reminder_sent
  marked_paid
  marked_unpaid
  credit_note_created
  deleted
  restored
  voided
}

enum PortalCredentialAuditAction {
  generated
  rotated
  revealed
}

enum LearningMaterialType {
  audio
  pdf
  image
  guitar_pro
}

enum AdminRole {
  owner
  teacher
}

enum StorageCleanupScope {
  booking_note_image
  booking_request_note_image
}

enum UnknownCountryMode {
  allow
  block
}

enum LessonPlanMaterialLinkField {
  lessonFocus
  goals
  activities
  homework
  sharedNotes
}

enum LessonPlanStatus {
  draft
  in_progress
  complete
}

enum LessonPlanTemplateCategory {
  technique
  theory
  repertoire
  exam_prep
  performance
  general
}

enum LessonSeriesStatus {
  active
  completed
  archived
}

enum LessonPlanSectionVisibility {
  student_visible
  teacher_only
}

// Origin of a lesson-credit batch — a paid package invoice, an admin manual
// grant, or a redeemed voucher that was issued as lesson credits.
enum LessonCreditSource {
  package_purchase
  admin_grant
  voucher_grant
}

// Lifecycle of a gift voucher. pending = awaiting Stripe payment; active =
// usable; expiry is derived from expiresAt at use-time (no separate state).
enum VoucherStatus {
  pending
  active
  redeemed
  void
}

// Why a customer account-credit ledger entry was written.
enum CreditLedgerReason {
  voucher_redemption
  invoice_application
  admin_adjustment
  refund
}

// Shape a promo popup takes on the public site.
enum PopupFormFactor {
  modal
  corner
  bar
}

// Entrance animation preset for a promo popup. Suppressed under
// prefers-reduced-motion; the popup still appears.
enum PopupAnimation {
  fade
  slide_up
  slide_in_right
  zoom
  bounce
  pulse
}

// Where the popup image sits relative to its text.
enum PopupImagePlacement {
  top
  side
  background
  none
}

// How often a visitor who has already seen a popup sees it again.
// `days` pairs with SitePopup.repeatDays.
enum PopupRepeatPolicy {
  once
  session
  days
  always
}

// Public website contact form submissions. These are stored even when email
// delivery fails so admins can follow up later and inspect retry logs.
model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Booking requests are the pre-approval records shown in the admin calendar.
// They remain separate from confirmed Booking rows so rejected/cancelled history
// can be tracked without polluting the confirmed bookings table.
model BookingRequest {
  id                    String                    @id @default(cuid())
  status                BookingRequestStatus      @default(pending)
  firstName             String                    @default("")
  lastName              String                    @default("")
  name                  String
  email                 String
  phone                 String
  address               String
  unitNumber            String?
  houseNumber           String                    @default("")
  streetName            String                    @default("")
  streetType            String                    @default("")
  suburb                String                    @default("")
  state                 String                    @default("")
  postcode              String                    @default("")
  lessonMode            LessonMode
  skillLevel            SkillLevel
  lessonDuration        LessonDuration
  customDurationMinutes Int?
  requestedStartAt      DateTime
  notes                 String?                   @db.Text
  notesContent          Json?
  isRecurring           Boolean                   @default(false)
  recurrenceEndAt       DateTime?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  approvedById          String?
  approvedBy            AdminUser?                @relation("RequestApprovals", fields: [approvedById], references: [id], onDelete: SetNull)
  assignedTeacherId     String?
  assignedTeacher       AdminUser?                @relation("BookingRequestAssignedTeacher", fields: [assignedTeacherId], references: [id], onDelete: SetNull)
  customerId            String?
  customer              Customer?                 @relation(fields: [customerId], references: [id], onDelete: SetNull)
  noteImages            BookingRequestNoteImage[]
  bookings              Booking[]

  @@index([requestedStartAt, status])
  @@index([customerId])
  @@index([assignedTeacherId])
}

// Images uploaded inline into booking-request notes before approval.
// Approval copies them to booking-scoped note images so confirmed bookings do
// not depend on request-only media routes.
model BookingRequestNoteImage {
  id               String         @id @default(cuid())
  bookingRequestId String
  bookingRequest   BookingRequest @relation(fields: [bookingRequestId], references: [id], onDelete: Cascade)
  storageKey       String
  mimeType         String
  sizeBytes        Int
  createdAt        DateTime       @default(now())

  @@index([bookingRequestId])
}

// Recurring booking template metadata used to generate/track multiple concrete
// bookings while preserving customer cadence details and an archive toggle.
model BookingSeries {
  id                    String         @id @default(cuid())
  firstName             String         @default("")
  lastName              String         @default("")
  name                  String
  email                 String
  phone                 String
  address               String
  unitNumber            String?
  houseNumber           String         @default("")
  streetName            String         @default("")
  streetType            String         @default("")
  suburb                String         @default("")
  state                 String         @default("")
  postcode              String         @default("")
  lessonMode            LessonMode
  skillLevel            SkillLevel
  lessonDuration        LessonDuration
  customDurationMinutes Int?
  dayOfWeek             Int
  startTimeLocal        String
  startDate             DateTime
  recurrenceEndAt       DateTime
  timezone              String
  isActive              Boolean        @default(true)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  assignedTeacherId     String?
  assignedTeacher       AdminUser?     @relation("BookingSeriesAssignedTeacher", fields: [assignedTeacherId], references: [id], onDelete: SetNull)
  customerId            String?
  customer              Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  bookings              Booking[]

  @@index([customerId])
  @@index([assignedTeacherId])
}

// Confirmed or cancelled lesson instances shown in admin/student calendar views.
// A Booking can be linked back to its original request and/or recurring series.
model Booking {
  id                    String                  @id @default(cuid())
  status                BookingStatus           @default(approved)
  firstName             String                  @default("")
  lastName              String                  @default("")
  name                  String
  email                 String
  phone                 String
  address               String
  unitNumber            String?
  houseNumber           String                  @default("")
  streetName            String                  @default("")
  streetType            String                  @default("")
  suburb                String                  @default("")
  state                 String                  @default("")
  postcode              String                  @default("")
  lessonMode            LessonMode
  skillLevel            SkillLevel
  lessonDuration        LessonDuration
  customDurationMinutes Int?
  startAt               DateTime
  endAt                 DateTime
  timezone              String
  notes                 String?                 @db.Text
  notesContent          Json?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  cancelledAt           DateTime?
  attendanceStatus      AttendanceStatus?
  attendanceMarkedAt    DateTime?
  attendanceMarkedById  String?
  reminderSentAt        DateTime?
  requestId             String?
  request               BookingRequest?         @relation(fields: [requestId], references: [id], onDelete: SetNull)
  seriesId              String?
  series                BookingSeries?          @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  assignedTeacherId     String?
  assignedTeacher       AdminUser?              @relation("BookingAssignedTeacher", fields: [assignedTeacherId], references: [id], onDelete: SetNull)
  customerId            String?
  customer              Customer?               @relation(fields: [customerId], references: [id], onDelete: SetNull)
  modifiedById          String?
  modifiedBy            AdminUser?              @relation("BookingEdits", fields: [modifiedById], references: [id], onDelete: SetNull)
  lessonCreditBatchId   String?
  lessonCreditBatch     LessonCreditBatch?      @relation(fields: [lessonCreditBatchId], references: [id], onDelete: SetNull)
  auditLogs             BookingAuditLog[]
  invoices              Invoice[]
  invoiceLinks          InvoiceBookingLink[]
  learningMaterials     LearningMaterial[]
  bookingLibraryMaterials BookingLibraryMaterial[]
  sourceMaterialFolders StudentMaterialFolder[] @relation("FolderSourceBooking")
  lessonPlan            LessonPlan?
  noteImages            BookingNoteImage[]
  rescheduleRequests    BookingRescheduleRequest[]

  @@index([startAt, status])
  @@index([customerId])
  @@index([assignedTeacherId])
}

// Append-only audit trail for booking/request lifecycle actions performed by an
// admin or system workflow (approval, move, cancel, reminders, etc).
model BookingAuditLog {
  id        String      @id @default(cuid())
  bookingId String?
  booking   Booking?    @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  action    AuditAction
  actorId   String?
  actor     AdminUser?  @relation(fields: [actorId], references: [id], onDelete: SetNull)
  details   String?
  createdAt DateTime    @default(now())

  @@index([createdAt])
  @@index([bookingId])
}

// Student-initiated reschedule requests against a confirmed booking. The admin
// (owner or assigned teacher) approves (moving the booking) or declines. A
// single pending request per booking is enforced in application logic.
model BookingRescheduleRequest {
  id               String                  @id @default(cuid())
  bookingId        String
  booking          Booking                 @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  requestedStartAt DateTime
  reason           String?                 @db.Text
  status           RescheduleRequestStatus @default(pending)
  createdAt        DateTime                @default(now())
  resolvedAt       DateTime?
  resolvedById     String?

  // DB-enforced "one pending reschedule request per booking" guard. MariaDB has
  // no partial indexes, and a STORED generated column may not reference a
  // foreign-key column (bookingId) directly, so we derive a flag from `status`
  // alone: pendingFlag = 1 while pending, NULL once resolved. A composite UNIQUE
  // index on (bookingId, pendingFlag) then allows at most one pending row per
  // booking (NULLs never collide, so resolved rows are unconstrained). Defined as
  // raw SQL in the migration; modeled here as Unsupported so Prisma never
  // reads/writes it and introspection stays in sync.
  // WARNING: Prisma cannot express STORED generated columns, so every
  // `migrate dev` emits a phantom `MODIFY pendingFlag tinyint NULL DEFAULT (...)`
  // for this column. That statement DEGRADES the generated column to a plain
  // default and breaks the guard on UPDATE — always delete it from a freshly
  // generated migration.
  pendingFlag Unsupported("tinyint")? @default(dbgenerated("(if(`status` = 'pending',1,NULL))"))

  @@unique([bookingId, pendingFlag], map: "BookingRescheduleRequest_bookingId_pendingFlag_key")
  @@index([status])
  @@index([bookingId])
}

// Images uploaded inline into booking notes (TipTap rich text).
// Tracked for serving via auth-guarded endpoints and storage cleanup.
model BookingNoteImage {
  id         String   @id @default(cuid())
  bookingId  String
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  storageKey String
  mimeType   String
  sizeBytes  Int
  createdAt  DateTime @default(now())

  @@index([bookingId])
}

// Admin console login identities. Session cookies store the email identifier,
// and routes re-load the current admin row for authorization checks.
model AdminUser {
  id                         String                             @id @default(cuid())
  email                      String                             @unique
  role                       AdminRole                          @default(owner)
  firstName                  String                             @default("")
  lastName                   String                             @default("")
  displayName                String
  passwordHash               String
  age                        Int?
  unitNumber                 String?
  houseNumber                String                             @default("")
  streetName                 String                             @default("")
  streetType                 String                             @default("")
  suburb                     String                             @default("")
  state                      String                             @default("")
  postcode                   String                             @default("")
  instruments                String?                            @db.Text
  specialisations            String?                            @db.Text
  background                 String?                            @db.Text
  musicalHistory             String?                            @db.Text
  profilePhotoStorageKey     String?
  profilePhotoMimeType       String?
  isActive                   Boolean                            @default(true)
  sessionInvalidBefore       DateTime?
  createdAt                  DateTime                           @default(now())
  updatedAt                  DateTime                           @updatedAt
  approvedRequests           BookingRequest[]                   @relation("RequestApprovals")
  assignedBookingRequests    BookingRequest[]                   @relation("BookingRequestAssignedTeacher")
  assignedBookingSeries      BookingSeries[]                    @relation("BookingSeriesAssignedTeacher")
  assignedBookings           Booking[]                          @relation("BookingAssignedTeacher")
  primaryTeacherCustomers    Customer[]                         @relation("CustomerPrimaryTeacher")
  editedBookings             Booking[]                          @relation("BookingEdits")
  auditLogs                  BookingAuditLog[]
  createdInvoices            Invoice[]                          @relation("InvoiceCreatedBy")
  updatedInvoices            Invoice[]                          @relation("InvoiceUpdatedBy")
  invoiceAuditLogs           InvoiceAuditLog[]                  @relation("InvoiceAuditActors")
  portalCredentialAuditLogs  CustomerPortalCredentialAuditLog[] @relation("PortalCredentialAuditActors")
  uploadedLearningMaterials  LearningMaterial[]                 @relation("LearningMaterialUploadedBy")
  createdLessonPlanTemplates LessonPlanTemplate[]               @relation("LessonPlanTemplateCreatedBy")
  updatedLessonPlanTemplates LessonPlanTemplate[]               @relation("LessonPlanTemplateUpdatedBy")
  createdLessonPlans         LessonPlan[]                       @relation("LessonPlanCreatedBy")
  updatedLessonPlans         LessonPlan[]                       @relation("LessonPlanUpdatedBy")
  lessonSeries               LessonSeries[]                     @relation("LessonSeriesTeacher")
  createdSeriesTemplates     LessonSeriesTemplate[]             @relation("LessonSeriesTemplateCreatedBy")
  createdChords              Chord[]                            @relation("ChordCreatedBy")
  createdChordCharts         ChordChart[]                       @relation("ChordChartCreatedBy")
  createdSitePopups          SitePopup[]                        @relation("SitePopupCreatedBy")
  uploadedLibraryItems       LibraryItem[]                      @relation("LibraryItemUploadedBy")
  assignedLibraryAssignments LibraryAssignment[]                @relation("LibraryAssignmentAssignedBy")
  assignedBookingLibraryMaterials BookingLibraryMaterial[]      @relation("BookingLibraryMaterialAssignedBy")
}

// Canonical customer profile derived from booking requests/bookings. Multiple
// bookings, portal credentials, invoices, and learning materials attach here.
model Customer {
  id                        String                             @id @default(cuid())
  firstName                 String                             @default("")
  lastName                  String                             @default("")
  fullName                  String
  normalizedFullName        String                             @default("")
  nameSearchTokens          String?
  email                     String
  phone                     String
  normalizedEmail           String
  normalizedPhone           String
  skillLevel                SkillLevel                         @default(beginner)
  lessonMode                LessonMode                         @default(in_person)
  unitNumber                String?
  houseNumber               String                             @default("")
  streetName                String                             @default("")
  streetType                String                             @default("")
  suburb                    String                             @default("")
  state                     String                             @default("")
  postcode                  String                             @default("")
  isArchived                Boolean                            @default(false)
  sessionInvalidBefore      DateTime?
  createdAt                 DateTime                           @default(now())
  updatedAt                 DateTime                           @updatedAt
  primaryTeacherId          String?
  primaryTeacher            AdminUser?                         @relation("CustomerPrimaryTeacher", fields: [primaryTeacherId], references: [id], onDelete: SetNull)
  bookingRequests           BookingRequest[]
  bookingSeries             BookingSeries[]
  bookings                  Booking[]
  invoices                  Invoice[]
  portalCredential          CustomerPortalCredential?
  portalCredentialAuditLogs CustomerPortalCredentialAuditLog[]
  learningMaterials         LearningMaterial[]
  materialFolders           StudentMaterialFolder[]
  inboundEmails             CustomerInboundEmail[]
  homeworkCompletions       HomeworkCompletion[]
  lessonSeries              LessonSeries[]
  lessonCreditBatches       LessonCreditBatch[]
  creditLedger              CustomerCreditLedger[]
  libraryAssignments        LibraryAssignment[]

  @@index([isArchived, fullName])
  @@index([normalizedFullName, postcode, isArchived])
  @@index([normalizedEmail])
  @@index([normalizedPhone])
  @@index([primaryTeacherId])
}

// Persisted inbound customer email snapshots imported from mailbox providers so
// admin history views can show inbound context without live mailbox reads.
model CustomerInboundEmail {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  provider   String   @default("imap")
  source     String   @default("imap")
  externalId String
  fromEmail  String
  toEmail    String?
  subject    String
  snippet    String   @db.Text
  bodyText   String?  @db.Text
  status     String   @default("received")
  receivedAt DateTime
  syncedAt   DateTime @default(now())

  @@unique([customerId, provider, externalId])
  @@index([provider, externalId])
  @@index([customerId, receivedAt])
}

// Portal credentials are stored as both a hash (verification) and encrypted
// plaintext (admin reveal workflow) with a separate audit trail for access.
model CustomerPortalCredential {
  id                String                             @id @default(cuid())
  customerId        String                             @unique
  customer          Customer                           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  passwordHash      String
  passwordEncrypted String
  generatedAt       DateTime                           @default(now())
  rotatedAt         DateTime?
  isActive          Boolean                            @default(true)
  createdAt         DateTime                           @default(now())
  updatedAt         DateTime                           @updatedAt
  auditLogs         CustomerPortalCredentialAuditLog[]

  @@index([isActive, generatedAt])
}

// Audit trail for credential generation/rotation/reveal events so sensitive
// credential actions remain attributable during support/admin workflows.
model CustomerPortalCredentialAuditLog {
  id           String                      @id @default(cuid())
  customerId   String
  customer     Customer                    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  credentialId String?
  credential   CustomerPortalCredential?   @relation(fields: [credentialId], references: [id], onDelete: SetNull)
  action       PortalCredentialAuditAction
  actorId      String?
  actor        AdminUser?                  @relation("PortalCredentialAuditActors", fields: [actorId], references: [id], onDelete: SetNull)
  details      String?
  createdAt    DateTime                    @default(now())

  @@index([customerId, createdAt])
  @@index([actorId, createdAt])
}

// Uploaded lesson resources tied to the customer and optionally to a booking.
// `bookingId` is nullable so admins can upload general resources not linked to
// one appointment (for example practice packs or reference PDFs).
model LearningMaterial {
  id              String                   @id @default(cuid())
  customerId      String
  customer        Customer                 @relation(fields: [customerId], references: [id], onDelete: Cascade)
  bookingId       String?
  booking         Booking?                 @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  uploadedById    String?
  uploadedBy      AdminUser?               @relation("LearningMaterialUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  title           String
  description     String?
  materialType    LearningMaterialType
  storageKey      String                   @unique
  mimeType        String
  sizeBytes       Int
  folderId        String?
  folder          StudentMaterialFolder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  /// Shared display order within (customerId, folderId). 0 = unpinned: unpinned rows
  /// sort above pinned rows, newest first. Every relocating write sets this to 0
  /// explicitly so a stale index is never carried into a new folder.
  sortOrder       Int                      @default(0)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  lessonPlanLinks LessonPlanMaterialLink[]

  @@index([customerId, bookingId, createdAt])
  @@index([bookingId, createdAt])
  @@index([customerId, folderId, createdAt])
  @@index([customerId, folderId, sortOrder])
}

// Per-student tree of folders that organize LearningMaterial rows. A folder is
// the primary organizing axis (bookingId is retained but demoted to metadata).
// `parentId` is a self-FK for arbitrary-depth nesting; `folderId` on a material
// is logical metadata only — `storageKey` (physical layout) never mirrors it.
// `sourceBookingId` is migration provenance set ONLY by the backfill script and
// keys its idempotent upsert; it is never set by a user action.
model StudentMaterialFolder {
  id              String                  @id @default(cuid())
  customerId      String
  customer        Customer                @relation(fields: [customerId], references: [id], onDelete: Cascade)
  parentId        String?
  parent          StudentMaterialFolder?  @relation("FolderParent", fields: [parentId], references: [id], onDelete: Cascade)
  children        StudentMaterialFolder[] @relation("FolderParent")
  name            String
  sourceBookingId String?
  sourceBooking   Booking?                @relation("FolderSourceBooking", fields: [sourceBookingId], references: [id], onDelete: SetNull)
  materials       LearningMaterial[]
  libraryAssignments LibraryAssignment[]
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@unique([customerId, sourceBookingId])
  @@index([customerId, parentId])
  @@index([sourceBookingId])
}

// Shared, NON-customer-scoped learning-materials Library. Unlike LearningMaterial
// (strictly per-customer), a LibraryItem is a single master blob referenced BY
// REFERENCE by many students through LibraryAssignment — one storageKey, N
// assignees, edits propagate to all. Bytes live under a `library/<uuid>`
// namespace that never collides with per-customer keys (`{customerId}/...`).
model LibraryItem {
  id           String               @id @default(cuid())
  title        String
  // Optional performer/composer supplied by staff or extracted locally. This is
  // deliberately separate from tags so remote identity lookups have an
  // unambiguous, non-user-visible input while existing Artist tags keep working.
  artist       String?
  description  String?
  materialType LearningMaterialType
  storageKey   String               @unique
  mimeType     String
  sizeBytes    Int
  // Normalized original upload filename (normalizeOriginalFilename). Nullable:
  // legacy rows and promoted per-customer materials never captured one. Explicit
  // VarChar(255) — Prisma's MySQL default of VARCHAR(191) would truncate below
  // the 255-char normalization rule and desync the duplicate probe.
  originalFilename String?             @db.VarChar(255)
  uploadedById     String?
  uploadedBy   AdminUser?           @relation("LibraryItemUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  tags         LibraryItemTag[]
  assignments  LibraryAssignment[]
  bookingMaterials BookingLibraryMaterial[]
  enrichmentRuns LibraryEnrichmentRun[]

  @@index([uploadedById])
  @@index([originalFilename])
  @@index([artist])
}

/// A durable, idempotent enrichment job. Uploads only enqueue this row; a
/// separately authenticated runner performs provider calls so an outage never
/// delays or fails an upload.
model LibraryEnrichmentRun {
  id            String   @id @default(cuid())
  libraryItemId String
  libraryItem   LibraryItem @relation(fields: [libraryItemId], references: [id], onDelete: Cascade)
  status        String   @default("queued")
  attempts      Int      @default(0)
  nextAttemptAt DateTime @default(now())
  startedAt     DateTime?
  completedAt   DateTime?
  lastError     String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  findings      LibraryEnrichmentFinding[]

  @@index([status, nextAttemptAt])
  @@index([libraryItemId, createdAt])
}

/// Every proposal is retained, including withheld proposals, so staff can
/// understand why a tag was or was not applied without changing manual tags.
model LibraryEnrichmentFinding {
  id              String   @id @default(cuid())
  enrichmentRunId String
  enrichmentRun   LibraryEnrichmentRun @relation(fields: [enrichmentRunId], references: [id], onDelete: Cascade)
  category        String
  value           String
  confidence      Float
  status          String
  sourceId        String?
  sourceUrl       String? @db.VarChar(1000)
  evidence        String? @db.Text
  createdAt       DateTime @default(now())

  @@index([enrichmentRunId])
  @@index([status])
}

/// Provider responses are cached by normalized identity. The runner never
/// stores score bytes, only compact metadata needed to corroborate a finding.
model LibraryEnrichmentCache {
  id        String   @id @default(cuid())
  provider  String
  cacheKey  String   @db.VarChar(512)
  payload   Json
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, cacheKey])
  @@index([expiresAt])
}

// Controlled tag vocabulary shared across all LibraryItems. `category` is the
// typed axis (Decade, Style, Key, Artist, ...) and `value` the picked/added
// term; `@@unique([category, value])` makes add-on-the-fly idempotent.
model Tag {
  id        String           @id @default(cuid())
  category  String
  value     String
  createdAt DateTime         @default(now())
  items     LibraryItemTag[]

  @@unique([category, value])
  @@index([category])
}

// Join between LibraryItem and Tag. The `@@index([tagId, libraryItemId])`
// covering index backs the `tags.some` EXISTS pattern the AND-search generates
// (one existence probe per selected category).
model LibraryItemTag {
  id            String      @id @default(cuid())
  libraryItemId String
  libraryItem   LibraryItem @relation(fields: [libraryItemId], references: [id], onDelete: Cascade)
  tagId         String
  tag           Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([libraryItemId, tagId])
  @@index([tagId])
  @@index([tagId, libraryItemId])
}

// By-reference assignment of a LibraryItem to a Customer. `@@unique` makes assign
// idempotent and unassign a single delete; cascade on either side removes the
// join (never the master blob). `assignedById` carries provenance.
model LibraryAssignment {
  id            String      @id @default(cuid())
  libraryItemId String
  libraryItem   LibraryItem @relation(fields: [libraryItemId], references: [id], onDelete: Cascade)
  customerId    String
  customer      Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assignedById  String?
  assignedBy    AdminUser?  @relation("LibraryAssignmentAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  /// Placement inside the student's folder tree. NULL = root, which is exactly
  /// where the separate "Assigned by teacher" list already effectively sat.
  /// Shares one order with LearningMaterial behind `lib:`-prefixed tree ids.
  folderId      String?
  folder        StudentMaterialFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())

  @@unique([libraryItemId, customerId])
  @@index([customerId])
  @@index([assignedById])
  @@index([customerId, folderId, sortOrder])
}

// Booking-scoped references to shared Library masters. This stays separate from
// LibraryAssignment so the same item can be generally assigned to a student and
// independently linked to one or more of their bookings.
model BookingLibraryMaterial {
  id            String      @id @default(cuid())
  bookingId     String
  booking       Booking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  libraryItemId String
  libraryItem   LibraryItem @relation(fields: [libraryItemId], references: [id], onDelete: Cascade)
  assignedById  String?
  assignedBy    AdminUser?  @relation("BookingLibraryMaterialAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())

  @@unique([bookingId, libraryItemId])
  @@index([libraryItemId])
  @@index([assignedById])
}

// Reusable structured lesson-plan templates that staff can apply to a booking
// before tailoring the copied plan for one concrete lesson.
// V2: `sections` holds an array of TipTap-JSON section objects. Legacy text
// fields are retained during the migration window and dropped in cleanup.
model LessonPlanTemplate {
  id           String                     @id @default(cuid())
  title        String
  description  String?                    @db.Text
  category     LessonPlanTemplateCategory @default(general)
  tags         String?                    @db.Text
  skillLevel   String?
  instrument   String?
  sections     Json?
  // Legacy fixed-text fields – kept during migration, removed in cleanup.
  lessonFocus  String                     @db.Text
  goals        String                     @db.Text
  activities   String                     @db.Text
  homework     String                     @db.Text
  sharedNotes  String                     @db.Text
  privateNotes String                     @db.Text
  isArchived   Boolean                    @default(false)
  createdById  String
  createdBy    AdminUser                  @relation("LessonPlanTemplateCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  updatedById  String?
  updatedBy    AdminUser?                 @relation("LessonPlanTemplateUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt
  lessonPlans  LessonPlan[]
  seriesSteps  LessonSeriesTemplateStep[]

  @@index([isArchived, updatedAt])
  @@index([createdById, isArchived, updatedAt])
  @@index([category, isArchived])
}

// One structured lesson plan per confirmed booking. Plans optionally remember
// the template they were copied from, but remain independent snapshots.
// V2: `sections` holds an array of TipTap-JSON section objects. Legacy text
// fields are retained during the migration window and dropped in cleanup.
model LessonPlan {
  id                  String                   @id @default(cuid())
  bookingId           String                   @unique
  booking             Booking                  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  sourceTemplateId    String?
  sourceTemplate      LessonPlanTemplate?      @relation(fields: [sourceTemplateId], references: [id], onDelete: SetNull)
  status              LessonPlanStatus         @default(draft)
  sections            Json?
  quickCaptureNotes   String?                  @db.Text
  seriesId            String?
  series              LessonSeries?            @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  seriesSequence      Int?
  // Legacy fixed-text fields – kept during migration, removed in cleanup.
  lessonFocus         String                   @db.Text
  goals               String                   @db.Text
  activities          String                   @db.Text
  homework            String                   @db.Text
  sharedNotes         String                   @db.Text
  privateNotes        String                   @db.Text
  createdById         String
  createdBy           AdminUser                @relation("LessonPlanCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  updatedById         String?
  updatedBy           AdminUser?               @relation("LessonPlanUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  materialLinks       LessonPlanMaterialLink[]
  homeworkCompletions HomeworkCompletion[]

  @@index([sourceTemplateId])
  @@index([updatedAt])
  @@index([seriesId, seriesSequence])
}

model LessonPlanMaterialLink {
  id           String                      @id @default(cuid())
  lessonPlanId String
  lessonPlan   LessonPlan                  @relation(fields: [lessonPlanId], references: [id], onDelete: Cascade)
  materialId   String
  material     LearningMaterial            @relation(fields: [materialId], references: [id], onDelete: Cascade)
  fieldKey     LessonPlanMaterialLinkField
  startOffset  Int
  endOffset    Int
  linkedText   String                      @db.Text
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt

  @@index([lessonPlanId, fieldKey, startOffset])
  @@index([materialId])
}

// Student homework completion tracking. Each row records one checked-off item
// from a lesson plan's checklist blocks. The checklistItemId matches the stable
// `itemId` attribute embedded in TipTap taskItem nodes.
model HomeworkCompletion {
  id              String     @id @default(cuid())
  lessonPlanId    String
  lessonPlan      LessonPlan @relation(fields: [lessonPlanId], references: [id], onDelete: Cascade)
  checklistItemId String
  customerId      String
  customer        Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  completedAt     DateTime   @default(now())
  note            String?    @db.Text

  @@unique([lessonPlanId, checklistItemId])
  @@index([customerId, lessonPlanId])
}

// Multi-lesson curriculum assigned to a student, optionally based on a series
// template. Tracks overall progress through the ordered lesson plans.
model LessonSeries {
  id               String                @id @default(cuid())
  title            String
  description      String?               @db.Text
  customerId       String?
  customer         Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  teacherId        String?
  teacher          AdminUser?            @relation("LessonSeriesTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  totalLessons     Int
  status           LessonSeriesStatus    @default(active)
  sourceTemplateId String?
  sourceTemplate   LessonSeriesTemplate? @relation(fields: [sourceTemplateId], references: [id], onDelete: SetNull)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  lessonPlans      LessonPlan[]

  @@index([customerId, status])
  @@index([teacherId, status])
}

// Pre-built multi-lesson curricula that define an ordered sequence of lesson
// plan templates. Can be instantiated into a LessonSeries for a student.
model LessonSeriesTemplate {
  id           String                     @id @default(cuid())
  title        String
  description  String?                    @db.Text
  category     LessonPlanTemplateCategory @default(general)
  skillLevel   String?
  instrument   String?
  totalLessons Int
  isArchived   Boolean                    @default(false)
  createdById  String
  createdBy    AdminUser                  @relation("LessonSeriesTemplateCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt
  steps        LessonSeriesTemplateStep[]
  series       LessonSeries[]

  @@index([isArchived, updatedAt])
}

// One step in a series template, linking to an optional lesson plan template
// and carrying sequence metadata.
model LessonSeriesTemplateStep {
  id                   String               @id @default(cuid())
  seriesTemplateId     String
  seriesTemplate       LessonSeriesTemplate @relation(fields: [seriesTemplateId], references: [id], onDelete: Cascade)
  lessonPlanTemplateId String?
  lessonPlanTemplate   LessonPlanTemplate?  @relation(fields: [lessonPlanTemplateId], references: [id], onDelete: SetNull)
  sequenceNumber       Int
  title                String?
  notes                String?              @db.Text

  @@unique([seriesTemplateId, sequenceNumber])
  @@index([lessonPlanTemplateId])
}

// Email delivery/outbox tracking used by the mail service and reminder jobs to
// record attempts, status, and provider errors.
model OutboundEmail {
  id         String   @id @default(cuid())
  toEmail    String
  subject    String
  htmlBody   String   @db.Text
  status     String
  provider   String   @default("smtp")
  externalId String?  @unique
  source     String   @default("app")
  error      String?  @db.Text
  createdAt  DateTime @default(now())
}

// Durable cleanup queue for storage objects whose metadata was already removed
// or whose rollback delete failed. Job routes retry until the blob is gone.
model StorageCleanupTask {
  id            String              @id @default(cuid())
  storageKey    String              @unique
  scope         StorageCleanupScope
  entityId      String
  attemptCount  Int                 @default(0)
  lastError     String?             @db.Text
  nextAttemptAt DateTime            @default(now())
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([nextAttemptAt, createdAt])
  @@index([scope, entityId])
}

// Invoice and credit note domain model. Customer-facing invoice data is
// denormalized onto the record so documents remain historically accurate even if
// the linked customer profile changes later.
model Invoice {
  id                   String                      @id @default(cuid())
  invoiceNumber        String                      @unique
  status               InvoiceStatus               @default(draft)
  documentType         InvoiceDocumentType         @default(invoice)
  taxMode              InvoiceTaxMode              @default(taxable)
  discountKind         InvoiceDiscountKind?
  discountValue        Int?
  discountCents        Int                         @default(0)
  currency             String                      @default("AUD")
  customerId           String?
  customer             Customer?                   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  bookingId            String?
  booking              Booking?                    @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  originalInvoiceId    String?
  originalInvoice      Invoice?                    @relation("InvoiceCreditNotes", fields: [originalInvoiceId], references: [id], onDelete: SetNull)
  creditNotes          Invoice[]                   @relation("InvoiceCreditNotes")
  customerFirstName    String                      @default("")
  customerLastName     String                      @default("")
  customerName         String
  customerEmail        String
  customerPhone        String
  customerAddress      String
  sellerBusinessName   String
  sellerAbn            String
  sellerEmail          String?
  bankName             String
  bankBsb              String
  bankAccountName      String
  bankAccountNumber    String
  paymentDetailsSource InvoicePaymentDetailsSource @default(system)
  subtotalCents        Int
  gstCents             Int
  totalCents           Int
  notes                String?                     @db.Text
  issuedAt             DateTime
  dueAt                DateTime
  sentAt               DateTime?
  paidAt               DateTime?
  paidVia              String?                     // "manual" | "stripe"
  payToken             String?                     @unique
  stripeCheckoutSessionId String?
  stripePaymentIntentId   String?
  lastReminderSentAt   DateTime?
  lastReminderStage    Int?
  isDeleted            Boolean                     @default(false)
  createdById          String?
  createdBy            AdminUser?                  @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById          String?
  updatedBy            AdminUser?                  @relation("InvoiceUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  lineItems            InvoiceLineItem[]
  bookingLinks         InvoiceBookingLink[]
  auditLogs            InvoiceAuditLog[]

  @@index([status, isDeleted, dueAt])
  @@index([documentType, createdAt])
  @@index([originalInvoiceId])
  @@index([customerId, createdAt])
  @@index([bookingId, createdAt])
  @@index([paidAt])
  @@index([lastReminderStage, dueAt])
}

// Persisted provenance for which bookings were billed on an invoice.
// This allows one invoice to cover multiple lessons without removing the
// legacy single `bookingId` field still used by older flows.
model InvoiceBookingLink {
  id        String   @id @default(cuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([invoiceId, bookingId])
  @@index([bookingId, createdAt])
}

// Ordered invoice rows persisted with calculated subtotal/GST/total values so
// rendered PDFs/emails match the saved financial snapshot exactly.
model InvoiceLineItem {
  id                String               @id @default(cuid())
  invoiceId         String
  invoice           Invoice              @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  kind              String               @default("custom")
  description       String
  quantity          Int                  @default(1)
  unitPriceCents    Int
  taxMode           InvoiceTaxMode       @default(taxable)
  discountKind      InvoiceDiscountKind?
  discountValue     Int?
  lineDiscountCents Int                  @default(0)
  lineSubtotalCents Int
  lineGstCents      Int
  lineTotalCents    Int
  sortOrder         Int                  @default(0)
  packageId         String?
  package           LessonPackage?       @relation(fields: [packageId], references: [id], onDelete: SetNull)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([invoiceId, sortOrder])
}

// Reusable lesson package configurations that admins can manage via the dashboard
// to quick-fill invoice line items.
model InvoiceProductPreset {
  id             String               @id @default(cuid())
  label          String
  description    String
  unitPriceCents Int
  discountKind   InvoiceDiscountKind?
  discountValue  Int?
  isActive       Boolean              @default(true)
  sortOrder      Int                  @default(0)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([isActive, sortOrder])
}

// Owner-managed lesson duration/price catalog used by admin billing and
// admin booking duration selectors.
model LessonPricingOption {
  id              String   @id @default(cuid())
  durationMinutes Int      @unique
  priceCents      Int
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isActive, sortOrder])
}

// CMS data for public pages (titles, leads, metrics, hero images).
model PublicPageContent {
  id         String   @id @default(cuid())
  pagePath   String // e.g., "/" or "/lessons"
  sectionKey String // e.g., "hero" or "metrics"
  content    Json // JSON object containing the section's fields
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([pagePath, sectionKey])
  @@index([pagePath])
}

// Customizable subject and body for system emails.
model EmailTemplate {
  id          String   @id @default(cuid())
  templateKey String   @unique // e.g., "customer_booking_reminder"
  subject     String
  htmlBody    String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Singleton config for the shared outbound email signature and optional email-only logo.
model EmailSignatureSettings {
  id             String   @id
  bodyText       String?  @db.Text
  logoStorageKey String?
  logoMimeType   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Singleton config for automated outbound email preferences and invoice reminder cadence.
model NotificationSettings {
  id                                String   @id
  globalAutomatedEmailEnabled       Boolean  @default(true)
  categoryPreferences               Json
  automaticInvoiceRemindersEnabled  Boolean  @default(true)
  invoiceReminderFirstDelayDays     Int      @default(7)
  invoiceReminderResendIntervalDays Int      @default(7)
  autoCreateInvoiceOnApproval       Boolean  @default(false)
  lessonReminderEnabled             Boolean  @default(false)
  lessonReminderHoursBefore         Int      @default(24)
  errorAlertsEnabled                Boolean  @default(true)
  createdAt                         DateTime @default(now())
  updatedAt                         DateTime @updatedAt
}

// Singleton config for public geoblocking policy on anonymous form/API submissions.
model GeoblockingSettings {
  id                 String             @id
  allowedCountries   Json
  unknownCountryMode UnknownCountryMode @default(allow)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

// Layout and style customization for generated invoices.
model InvoiceTemplate {
  id          String   @id @default(cuid())
  isDefault   Boolean  @default(true)
  logoUrl     String?
  accentColor String?  @default("#2247d8")
  footerText  String?  @db.Text
  headerInfo  String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Append-only audit trail for invoice lifecycle changes (send, paid, reminders,
// credit notes, delete/restore, etc).
model InvoiceAuditLog {
  id        String             @id @default(cuid())
  invoiceId String
  invoice   Invoice            @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  action    InvoiceAuditAction
  actorId   String?
  actor     AdminUser?         @relation("InvoiceAuditActors", fields: [actorId], references: [id], onDelete: SetNull)
  details   String?
  createdAt DateTime           @default(now())

  @@index([invoiceId, createdAt])
  @@index([actorId])
}

// Records of application deployments triggered via the web console or CLI.
model DeployUpdate {
  id             String         @id @default(cuid())
  branch         String
  release        String
  appliedAt      DateTime       @default(now())
  commit         String         @unique
  shortCommit    String
  previousCommit String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  commits        DeployCommit[]

  @@index([appliedAt])
}

// Individual git commit metadata included in a specific deployment.
model DeployCommit {
  id             String       @id @default(cuid())
  deployUpdateId String
  deployUpdate   DeployUpdate @relation(fields: [deployUpdateId], references: [id], onDelete: Cascade)
  hash           String
  shortHash      String
  authorName     String
  authoredAt     DateTime
  subject        String       @db.Text
  body           String?      @db.Text
  createdAt      DateTime     @default(now())

  @@index([deployUpdateId])
}

// Saved chord voicings created by admin users for the chord library.
// The `diagram` JSON field stores a ChordDiagramData object with
// fingerings, barres, tuning, and left-handed flag.
model Chord {
  id          String           @id @default(cuid())
  name        String
  root        String
  quality     String
  diagram     Json
  isArchived  Boolean          @default(false)
  createdById String
  createdBy   AdminUser        @relation("ChordCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  chartLinks  ChordChartItem[]

  @@index([isArchived, name])
  @@index([root, quality, isArchived])
  @@index([createdById])
}

// A named collection of chord diagrams for display/print as a chord sheet.
// Designed for working out songs — title holds the song name, items hold
// the chords in order with optional section annotations.
model ChordChart {
  id          String           @id @default(cuid())
  title       String
  description String?          @db.Text
  isArchived  Boolean          @default(false)
  createdById String
  createdBy   AdminUser        @relation("ChordChartCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  items       ChordChartItem[]

  @@index([isArchived, updatedAt])
  @@index([createdById])
}

// Join table linking chords to charts with ordering and optional annotations.
model ChordChartItem {
  id         String     @id @default(cuid())
  chartId    String
  chart      ChordChart @relation(fields: [chartId], references: [id], onDelete: Cascade)
  chordId    String
  chord      Chord      @relation(fields: [chordId], references: [id], onDelete: Cascade)
  sortOrder  Int        @default(0)
  annotation String?

  @@unique([chartId, chordId])
  @@index([chartId, sortOrder])
  @@index([chordId])
}

// Application system logs for diagnostic and troubleshooting purposes.
model SystemLog {
  id        String   @id @default(cuid())
  level     String // info, warn, error
  event     String
  message   String   @db.Text
  meta      Json?
  createdAt DateTime @default(now())

  @@index([level])
  @@index([event])
  @@index([createdAt])
}

// Individual page view events for public website analytics.
// Captured by a client-side beacon firing to /api/analytics/pageview.
// No PII is stored: IP addresses are used transiently for geo-lookup but never persisted.
// Raw events are retained for 90 days then purged by the analytics-purge cron job.
model PageView {
  id         String   @id @default(cuid())
  path       String // e.g. "/lessons", "/book"
  referrer   String? // referrer domain only, e.g. "google.com"
  country    String? // ISO 3166-1 alpha-2, e.g. "AU"
  deviceType String // "desktop", "mobile", "tablet"
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([path, createdAt])
}

// Pre-aggregated daily page view counts for fast historical queries.
// Populated by the analytics-rollup cron job; retained indefinitely.
// Uses non-nullable fields with empty-string defaults so the composite unique
// constraint works correctly in MySQL/MariaDB (NULL breaks unique matching).
model PageViewDaily {
  id         String   @id @default(cuid())
  date       DateTime // start-of-day, e.g. 2026-04-15T00:00:00
  path       String
  referrer   String   @default("")
  country    String   @default("")
  deviceType String
  count      Int      @default(0)

  @@unique([date, path, referrer, country, deviceType])
  @@index([date])
  @@index([path, date])
}

// Owner-managed prepaid lesson package definitions sold online or granted by
// admins. A purchased package grants a LessonCreditBatch on invoice payment.
model LessonPackage {
  id              String            @id @default(cuid())
  label           String
  description     String?
  lessonCount     Int
  durationMinutes Int?
  priceCents      Int
  validityDays    Int?
  isActive        Boolean           @default(true)
  sortOrder       Int               @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  creditBatches   LessonCreditBatch[]
  invoiceLineItems InvoiceLineItem[]

  @@index([isActive, sortOrder])
}

// A batch of prepaid lesson credits owned by a customer. Credits auto-consume
// FIFO (soonest expiry) on booking when the duration matches (or is unset).
model LessonCreditBatch {
  id                String             @id @default(cuid())
  customerId        String
  customer          Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  durationMinutes   Int?
  initialQuantity   Int
  remainingQuantity Int
  source            LessonCreditSource
  sourceInvoiceId   String?
  packageId         String?
  package           LessonPackage?     @relation(fields: [packageId], references: [id], onDelete: SetNull)
  note              String?
  expiresAt         DateTime?
  createdById       String?
  createdAt         DateTime           @default(now())
  bookings          Booking[]

  // `map` pins the DB index name to the one 20260617010000 created; without it
  // every `migrate dev` emits a drop/recreate of this index as phantom drift.
  @@unique([sourceInvoiceId, packageId, note], name: "LessonCreditBatch_grant_dedupe", map: "LessonCreditBatch_grant_dedupe")
  @@index([customerId])
}

// Internal gift vouchers sold online via Stripe or comp-issued by admins.
// Redemption converts the monetary value into customer account credit.
model Voucher {
  id                      String        @id @default(cuid())
  code                    String        @unique
  valueCents              Int
  currency                String        @default("AUD")
  status                  VoucherStatus @default(pending)
  purchaserName           String?
  purchaserEmail          String?
  recipientName           String?
  recipientEmail          String?
  message                 String?       @db.Text
  issuedById              String?
  stripeCheckoutSessionId String?
  stripePaymentIntentId   String?
  paidVia                 String?
  expiresAt               DateTime
  redeemedAt              DateTime?
  redeemedByCustomerId    String?
  createdAt               DateTime      @default(now())

  @@index([status])
}

// Append-only monetary account-credit ledger for a customer. The current
// balance is the latest row's balanceAfterCents (ordered by createdAt).
model CustomerCreditLedger {
  id               String             @id @default(cuid())
  customerId       String
  customer         Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  amountCents      Int
  balanceAfterCents Int
  reason           CreditLedgerReason
  sourceVoucherId  String?
  sourceInvoiceId  String?
  note             String?
  createdById      String?
  createdAt        DateTime           @default(now())

  @@index([customerId])
}

// Admin-authored promotional popup for the public site. Content, styling,
// animation, schedule and display rules all live on the row so the public
// renderer needs a single query. A popup with no startAt/endAt is always-on
// while enabled; when several are live the most recently created wins.
model SitePopup {
  id                    String              @id @default(cuid())
  title                 String // internal name, never shown to visitors
  enabled               Boolean             @default(false)
  heading               String
  bodyHtml              String              @db.Text // TipTap output
  imageUrl              String?
  imageAlt              String?
  ctaLabel              String?
  ctaUrl                String?
  formFactor            PopupFormFactor     @default(modal)
  animation             PopupAnimation      @default(fade)
  backgroundColor       String              @default("#ffffff")
  textColor             String              @default("#111111")
  buttonBackgroundColor String              @default("#2247d8")
  buttonTextColor       String              @default("#ffffff")
  widthPx               Int?
  cornerRadiusPx        Int?
  imagePlacement        PopupImagePlacement @default(none)
  startAt               DateTime?
  endAt                 DateTime?
  targetPaths           Json? // array of public paths; null/empty means every public page
  delaySeconds          Int                 @default(0)
  repeatPolicy          PopupRepeatPolicy   @default(session)
  repeatDays            Int? // only read when repeatPolicy is `days`
  createdById           String
  createdBy             AdminUser           @relation("SitePopupCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  dayStats              PopupDayStat[]

  @@index([enabled, startAt, endAt])
  @@index([enabled, createdAt])
  @@index([createdById])
}

// Per-day performance counters for a popup, written by upsert on the
// (popupId, day) unique key. `day` is start-of-day, matching PageViewDaily.
model PopupDayStat {
  id          String    @id @default(cuid())
  popupId     String
  popup       SitePopup @relation(fields: [popupId], references: [id], onDelete: Cascade)
  day         DateTime // start-of-day, e.g. 2026-07-22T00:00:00
  impressions Int       @default(0)
  clicks      Int       @default(0)
  dismissals  Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // The unique key already indexes (popupId, day) for range queries.
  @@unique([popupId, day])
}

// Singleton config for the school's global opening hours, used to derive
// bookable slots (business hours minus a teacher's existing bookings).
// `weekdays` is a POSITIONAL array of exactly 7 entries — the array index IS
// the weekday, 0=Sunday..6=Saturday (matching `Date#getDay`), and an entry
// carries no weekday tag of its own:
//   [{ "isOpen": false, "openMinute": 540, "closeMinute": 1020 }, ...]
// Positional by construction, so a duplicate or missing weekday is structurally
// impossible rather than something anyone has to validate. Minutes are
// wall-clock minutes from midnight in the school's local timezone.
// Read and validated by `getBusinessHours()` in src/lib/booking/business-hours.ts.
model BusinessHours {
  id                     String   @id
  weekdays               Json
  slotGranularityMinutes Int      @default(30)
  minimumNoticeHours     Int      @default(24)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}
