// Prisma schema for the LessonFlow app.
// Production and test workflows now target MySQL (`provider = "mysql"`), so
// helper scripts should provide a mysql:// DATABASE_URL for Prisma commands.
// Historical migration note: a baseline migration was added for fresh MySQL
// databases; existing databases may need `prisma migrate resolve --applied`
// rather than executing baseline SQL directly.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum LessonMode {
  in_person
  video
}

enum SkillLevel {
  beginner
  intermediate
  advanced
}

enum LessonDuration {
  min30
  min60
}

enum BookingRequestStatus {
  pending
  approved
  rejected
  cancelled
}

enum BookingStatus {
  approved
  cancelled
}

enum AuditAction {
  created
  approved
  rejected
  moved
  cancelled
  edited
  reminder_sent
  custom_email_sent
  series_removed
}

enum InvoiceStatus {
  draft
  sent
  paid
  void
}

enum InvoiceDocumentType {
  invoice
  credit_note
}

enum InvoiceTaxMode {
  taxable
  gst_free
}

enum InvoiceAuditAction {
  created
  edited
  sent
  reminder_sent
  marked_paid
  marked_unpaid
  credit_note_created
  deleted
  restored
  voided
}

enum PortalCredentialAuditAction {
  generated
  rotated
  revealed
}

enum LearningMaterialType {
  audio
  pdf
}

// Public website contact form submissions. These are stored even when email
// delivery fails so admins can follow up later and inspect retry logs.
model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Booking requests are the pre-approval records shown in the admin calendar.
// They remain separate from confirmed Booking rows so rejected/cancelled history
// can be tracked without polluting the confirmed bookings table.
model BookingRequest {
  id                    String               @id @default(cuid())
  status                BookingRequestStatus @default(pending)
  firstName             String               @default("")
  lastName              String               @default("")
  name                  String
  email                 String
  phone                 String
  address               String
  unitNumber            String?
  houseNumber           String               @default("")
  streetName            String               @default("")
  streetType            String               @default("")
  suburb                String               @default("")
  state                 String               @default("")
  postcode              String               @default("")
  lessonMode            LessonMode
  skillLevel            SkillLevel
  lessonDuration        LessonDuration
  customDurationMinutes Int?
  requestedStartAt      DateTime
  notes                 String?
  isRecurring           Boolean              @default(false)
  recurrenceEndAt       DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  approvedById          String?
  approvedBy            AdminUser?           @relation("RequestApprovals", fields: [approvedById], references: [id], onDelete: SetNull)
  customerId            String?
  customer              Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  bookings              Booking[]

  @@index([requestedStartAt, status])
  @@index([customerId])
}

// Recurring booking template metadata used to generate/track multiple concrete
// bookings while preserving customer cadence details and an archive toggle.
model BookingSeries {
  id                    String         @id @default(cuid())
  firstName             String         @default("")
  lastName              String         @default("")
  name                  String
  email                 String
  phone                 String
  address               String
  unitNumber            String?
  houseNumber           String         @default("")
  streetName            String         @default("")
  streetType            String         @default("")
  suburb                String         @default("")
  state                 String         @default("")
  postcode              String         @default("")
  lessonMode            LessonMode
  skillLevel            SkillLevel
  lessonDuration        LessonDuration
  customDurationMinutes Int?
  dayOfWeek             Int
  startTimeLocal        String
  startDate             DateTime
  recurrenceEndAt       DateTime
  timezone              String
  isActive              Boolean        @default(true)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  customerId            String?
  customer              Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  bookings              Booking[]

  @@index([customerId])
}

// Confirmed or cancelled lesson instances shown in admin/student calendar views.
// A Booking can be linked back to its original request and/or recurring series.
model Booking {
  id                    String             @id @default(cuid())
  status                BookingStatus      @default(approved)
  firstName             String             @default("")
  lastName              String             @default("")
  name                  String
  email                 String
  phone                 String
  address               String
  unitNumber            String?
  houseNumber           String             @default("")
  streetName            String             @default("")
  streetType            String             @default("")
  suburb                String             @default("")
  state                 String             @default("")
  postcode              String             @default("")
  lessonMode            LessonMode
  skillLevel            SkillLevel
  lessonDuration        LessonDuration
  customDurationMinutes Int?
  startAt               DateTime
  endAt                 DateTime
  timezone              String
  notes                 String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  cancelledAt           DateTime?
  requestId             String?
  request               BookingRequest?    @relation(fields: [requestId], references: [id], onDelete: SetNull)
  seriesId              String?
  series                BookingSeries?     @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  customerId            String?
  customer              Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  modifiedById          String?
  modifiedBy            AdminUser?         @relation("BookingEdits", fields: [modifiedById], references: [id], onDelete: SetNull)
  auditLogs             BookingAuditLog[]
  invoices              Invoice[]
  learningMaterials     LearningMaterial[]

  @@index([startAt, status])
  @@index([customerId])
}

// Append-only audit trail for booking/request lifecycle actions performed by an
// admin or system workflow (approval, move, cancel, reminders, etc).
model BookingAuditLog {
  id        String      @id @default(cuid())
  bookingId String?
  booking   Booking?    @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  action    AuditAction
  actorId   String?
  actor     AdminUser?  @relation(fields: [actorId], references: [id], onDelete: SetNull)
  details   String?
  createdAt DateTime    @default(now())

  @@index([createdAt])
  @@index([bookingId])
}

// Admin console login identities. Session cookies store the email identifier,
// and routes re-load the current admin row for authorization checks.
model AdminUser {
  id                        String                             @id @default(cuid())
  email                     String                             @unique
  displayName               String
  passwordHash              String
  isActive                  Boolean                            @default(true)
  createdAt                 DateTime                           @default(now())
  updatedAt                 DateTime                           @updatedAt
  approvedRequests          BookingRequest[]                   @relation("RequestApprovals")
  editedBookings            Booking[]                          @relation("BookingEdits")
  auditLogs                 BookingAuditLog[]
  createdInvoices           Invoice[]                          @relation("InvoiceCreatedBy")
  updatedInvoices           Invoice[]                          @relation("InvoiceUpdatedBy")
  invoiceAuditLogs          InvoiceAuditLog[]                  @relation("InvoiceAuditActors")
  portalCredentialAuditLogs CustomerPortalCredentialAuditLog[] @relation("PortalCredentialAuditActors")
  uploadedLearningMaterials LearningMaterial[]                 @relation("LearningMaterialUploadedBy")
}

// Canonical customer profile derived from booking requests/bookings. Multiple
// bookings, portal credentials, invoices, and learning materials attach here.
model Customer {
  id                        String                             @id @default(cuid())
  firstName                 String                             @default("")
  lastName                  String                             @default("")
  fullName                  String
  normalizedFullName        String                             @default("")
  nameSearchTokens          String?
  email                     String
  phone                     String
  normalizedEmail           String
  normalizedPhone           String
  skillLevel                SkillLevel                         @default(beginner)
  lessonMode                LessonMode                         @default(in_person)
  unitNumber                String?
  houseNumber               String                             @default("")
  streetName                String                             @default("")
  streetType                String                             @default("")
  suburb                    String                             @default("")
  state                     String                             @default("")
  postcode                  String                             @default("")
  isArchived                Boolean                            @default(false)
  createdAt                 DateTime                           @default(now())
  updatedAt                 DateTime                           @updatedAt
  bookingRequests           BookingRequest[]
  bookingSeries             BookingSeries[]
  bookings                  Booking[]
  invoices                  Invoice[]
  portalCredential          CustomerPortalCredential?
  portalCredentialAuditLogs CustomerPortalCredentialAuditLog[]
  learningMaterials         LearningMaterial[]

  @@index([isArchived, fullName])
  @@index([normalizedFullName, postcode, isArchived])
  @@index([normalizedEmail])
  @@index([normalizedPhone])
}

// Portal credentials are stored as both a hash (verification) and encrypted
// plaintext (admin reveal workflow) with a separate audit trail for access.
model CustomerPortalCredential {
  id                String                             @id @default(cuid())
  customerId        String                             @unique
  customer          Customer                           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  passwordHash      String
  passwordEncrypted String
  generatedAt       DateTime                           @default(now())
  rotatedAt         DateTime?
  isActive          Boolean                            @default(true)
  createdAt         DateTime                           @default(now())
  updatedAt         DateTime                           @updatedAt
  auditLogs         CustomerPortalCredentialAuditLog[]

  @@index([isActive, generatedAt])
}

// Audit trail for credential generation/rotation/reveal events so sensitive
// credential actions remain attributable during support/admin workflows.
model CustomerPortalCredentialAuditLog {
  id           String                      @id @default(cuid())
  customerId   String
  customer     Customer                    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  credentialId String?
  credential   CustomerPortalCredential?   @relation(fields: [credentialId], references: [id], onDelete: SetNull)
  action       PortalCredentialAuditAction
  actorId      String?
  actor        AdminUser?                  @relation("PortalCredentialAuditActors", fields: [actorId], references: [id], onDelete: SetNull)
  details      String?
  createdAt    DateTime                    @default(now())

  @@index([customerId, createdAt])
  @@index([actorId, createdAt])
}

// Uploaded lesson resources tied to the customer and optionally to a booking.
// `bookingId` is nullable so admins can upload general resources not linked to
// one appointment (for example practice packs or reference PDFs).
model LearningMaterial {
  id           String               @id @default(cuid())
  customerId   String
  customer     Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  bookingId    String?
  booking      Booking?             @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  uploadedById String?
  uploadedBy   AdminUser?           @relation("LearningMaterialUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  title        String
  description  String?
  materialType LearningMaterialType
  storageKey   String               @unique
  mimeType     String
  sizeBytes    Int
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([customerId, bookingId, createdAt])
  @@index([bookingId, createdAt])
}

// Email delivery/outbox tracking used by the mail service and reminder jobs to
// record attempts, status, and provider errors.
model OutboundEmail {
  id        String   @id @default(cuid())
  toEmail   String
  subject   String
  htmlBody  String   @db.Text
  status    String
  error     String?  @db.Text
  createdAt DateTime @default(now())
}

// Invoice and credit note domain model. Customer-facing invoice data is
// denormalized onto the record so documents remain historically accurate even if
// the linked customer profile changes later.
model Invoice {
  id                 String              @id @default(cuid())
  invoiceNumber      String              @unique
  status             InvoiceStatus       @default(draft)
  documentType       InvoiceDocumentType @default(invoice)
  taxMode            InvoiceTaxMode      @default(taxable)
  currency           String              @default("AUD")
  customerId         String?
  customer           Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  bookingId          String?
  booking            Booking?            @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  originalInvoiceId  String?
  originalInvoice    Invoice?            @relation("InvoiceCreditNotes", fields: [originalInvoiceId], references: [id], onDelete: SetNull)
  creditNotes        Invoice[]           @relation("InvoiceCreditNotes")
  customerFirstName  String              @default("")
  customerLastName   String              @default("")
  customerName       String
  customerEmail      String
  customerPhone      String
  customerAddress    String
  sellerBusinessName String
  sellerAbn          String
  sellerEmail        String?
  bankName           String
  bankBsb            String
  bankAccountName    String
  bankAccountNumber  String
  subtotalCents      Int
  gstCents           Int
  totalCents         Int
  notes              String?
  issuedAt           DateTime
  dueAt              DateTime
  sentAt             DateTime?
  paidAt             DateTime?
  lastReminderSentAt DateTime?
  lastReminderStage  Int?
  isDeleted          Boolean             @default(false)
  createdById        String?
  createdBy          AdminUser?          @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById        String?
  updatedBy          AdminUser?          @relation("InvoiceUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  lineItems          InvoiceLineItem[]
  auditLogs          InvoiceAuditLog[]

  @@index([status, isDeleted, dueAt])
  @@index([documentType, createdAt])
  @@index([originalInvoiceId])
  @@index([customerId, createdAt])
  @@index([bookingId, createdAt])
  @@index([paidAt])
  @@index([lastReminderStage, dueAt])
}

// Ordered invoice rows persisted with calculated subtotal/GST/total values so
// rendered PDFs/emails match the saved financial snapshot exactly.
model InvoiceLineItem {
  id                String         @id @default(cuid())
  invoiceId         String
  invoice           Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  kind              String         @default("custom")
  description       String
  quantity          Int            @default(1)
  unitPriceCents    Int
  taxMode           InvoiceTaxMode @default(taxable)
  lineSubtotalCents Int
  lineGstCents      Int
  lineTotalCents    Int
  sortOrder         Int            @default(0)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([invoiceId, sortOrder])
}

// Reusable lesson package configurations that admins can manage via the dashboard
// to quick-fill invoice line items.
model InvoiceProductPreset {
  id             String   @id @default(cuid())
  label          String
  description    String
  unitPriceCents Int
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([isActive, sortOrder])
}

// CMS data for public pages (titles, leads, metrics, hero images).
model PublicPageContent {
  id         String   @id @default(cuid())
  pagePath   String // e.g., "/" or "/lessons"
  sectionKey String // e.g., "hero" or "metrics"
  content    Json // JSON object containing the section's fields
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([pagePath, sectionKey])
  @@index([pagePath])
}

// Customizable subject and body for system emails.
model EmailTemplate {
  id          String   @id @default(cuid())
  templateKey String   @unique // e.g., "customer_booking_reminder"
  subject     String
  htmlBody    String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Layout and style customization for generated invoices.
model InvoiceTemplate {
  id          String   @id @default(cuid())
  isDefault   Boolean  @default(true)
  logoUrl     String?
  accentColor String?  @default("#2247d8")
  footerText  String?  @db.Text
  headerInfo  String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Append-only audit trail for invoice lifecycle changes (send, paid, reminders,
// credit notes, delete/restore, etc).
model InvoiceAuditLog {
  id        String             @id @default(cuid())
  invoiceId String
  invoice   Invoice            @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  action    InvoiceAuditAction
  actorId   String?
  actor     AdminUser?         @relation("InvoiceAuditActors", fields: [actorId], references: [id], onDelete: SetNull)
  details   String?
  createdAt DateTime           @default(now())

  @@index([invoiceId, createdAt])
  @@index([actorId])
}
